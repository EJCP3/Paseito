# Copia a .env y rellena. No subas .env al repositorio.

# Base de datos (PostgreSQL). En producción: sslmode=require y usuario sin permisos DDL.
DATABASE_URL=

# Better Auth: >= 32 bytes aleatorios (openssl rand -base64 32), distinto en cada entorno.
BETTER_AUTH_SECRET=
# Origen exacto de la web (https en producción). Si falta, apunta a http://localhost:3000.
APP_URL=http://localhost:3000

# Google OAuth. Redirect: <APP_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudinary (solo servidor)
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=

# Resend (correo). El remitente debe tener dominio verificado (SPF/DKIM).
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Cabecera con la IP real del cliente, fijada por tu plataforma/proxy (sobrescribiendo lo del cliente):
# x-real-ip, cf-connecting-ip, x-vercel-forwarded-for... Vacío = IP del socket (sin proxy).
IP_HEADER=

# Sal de la analítica anónima. Si falta, se deriva de BETTER_AUTH_SECRET.
ANALYTICS_SALT=

# En producción: NODE_ENV=production (activa HSTS y CSP Report-Only)
