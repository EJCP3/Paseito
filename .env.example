# Paseito — Variables de entorno
# Copia este archivo como .env y completa los valores

# Base de datos PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/paseito?schema=public"

# Better Auth — Secreto para firmar tokens (mínimo 32 caracteres)
BETTER_AUTH_SECRET="tu-secreto-super-seguro-de-al-menos-32-caracteres"

# Cloudflare R2 (o S3-compatible) — Para subida de panorámicas
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="paseito-panoramas"

# URL de la app
APP_URL="http://localhost:3000"
