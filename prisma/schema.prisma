// Prisma Schema — Paseito Marketplace
// Modelos para inmuebles, vehículos, tours virtuales 360°

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// Enums
// ============================================

enum ListingType {
  APARTMENT
  HOUSE
  VILLA
  VEHICLE
}

enum ListingStatus {
  DRAFT
  ACTIVE
  SOLD
  PAUSED
  PENDING_REVIEW
}

enum Role {
  USER
  ADMIN
}

enum ReportReason {
  SPAM
  FRAUD
  INAPPROPRIATE
  MISLEADING_PRICE
  OTHER
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum ListingEventType {
  VIEW
  CONTACT_CLICK
  SCHEDULE_CLICK
  TOUR_OPEN
  TOUR_TIME
}

enum FeaturePlacement {
  HERO
  SIDEBAR
  BADGE
}

enum FeatureStatus {
  PENDING
  ACTIVE
  CANCELLED
}

enum HotspotType {
  LINK
  INFO
}

enum ListingMode {
  SALE
  RENT_LONG_TERM
  RENT_DAILY
}

enum FurnishedStatus {
  NONE
  PARTIAL
  FULL
}

enum PropertyCondition {
  NEW
  RENOVATED
  USED
  UNDER_CONSTRUCTION
}

enum AvailabilityStatus {
  AVAILABLE
  BLOCKED
  BOOKED
}

// ============================================
// Models
// ============================================

model User {
  id               String     @id @default(uuid())
  email            String     @unique
  emailVerified    Boolean    @default(false)
  name             String
  image            String?
  phone            String?
  instagramUrl     String?
  facebookUrl      String?
  tiktokUrl        String?
  websiteUrl       String?
  // 0 = sin verificar, 1 = verificado. Asignado a mano por ahora (Prisma
  // Studio / endpoint de admin); el campo queda listo para un flujo real luego.
  verificationTier Int        @default(0)
  role             Role       @default(USER)
  suspended        Boolean    @default(false)
  suspendedAt      DateTime?
  termsAcceptedAt  DateTime? // RQ-LEGAL-01
  reports          Report[]   @relation("Reporter")
  resolvedReports  Report[]   @relation("Resolver")
  auditLogs        AuditLog[]
  listings         Listing[]
  sessions         Session[]
  accounts         Account[]
  favorites        Favorite[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

// ============================================
// Better Auth
// ============================================

model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Verification {
  id         String    @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt
}

model Listing {
  id          String        @id @default(uuid())
  slug        String        @unique
  type        ListingType
  // Venta/alquiler mensual (apartamento y casa) o alquiler diario (villa,
  // siempre RENT_DAILY, asignado por el servicio — no lo elige el usuario).
  // Null para vehículos y para anuncios creados antes de este campo.
  mode        ListingMode?
  title       String
  description String
  price       Decimal
  currency    String        @default("USD")
  status      ListingStatus @default(DRAFT)

  // Campos de inmueble
  areaM2    Float?
  bedrooms  Int?
  bathrooms Float? // admite medios baños (ej. 2.5)
  parking   Int?
  sector    String?
  city      String?

  // Coordenadas exactas confirmadas por el dueño en el mini-mapa al publicar
  // (arrastrando el pin). Se usan para detectar los puntos de interés cercanos.
  latitude  Float?
  longitude Float?

  // Comunes a apartamento/casa/villa
  furnished        FurnishedStatus?
  petsAllowed      Boolean?
  condition        PropertyCondition?
  constructionYear Int?
  amenities        String[]           @default([])

  // Apartamento
  floorNumber    Int?
  totalFloors    Int?
  hasElevator    Boolean?
  water24h       Boolean?
  power24h       Boolean?
  hasBalcony     Boolean?
  maintenanceFee Decimal?

  // Casa
  floors       Int?
  hasPatio     Boolean?
  patioSize    Float?
  hasPool      Boolean?
  hasGarage    Boolean?
  garageSpots  Int?
  hasCistern   Boolean?
  hasGenerator Boolean?
  landAreaM2   Float?

  // Villa (siempre alquiler por día)
  villaPoolType      String?
  villaPoolSize      Float?
  guestCapacity      Int?
  bedsCount          Int?
  villaServices      String[] @default([])
  pricePerDay        Decimal?
  pricePerWeek       Decimal?
  minNights          Int?
  securityDeposit    Decimal?
  cancellationPolicy String?
  checkInTime        String?
  checkOutTime       String?

  // Campos de vehículo
  brand     String?
  model     String?
  year      Int?
  mileageKm Int?

  // Contactos/redes que el dueño eligió mostrar en este anuncio:
  // [{ type: 'whatsapp'|'instagram'|'facebook'|'tiktok'|'website', value: string }]
  contacts Json?

  // Fecha en que el dueño consintió mostrar sus contactos (RQ-LEGAL-02). null = sin consentimiento.
  contactConsentAt DateTime?

  // Relaciones
  owner        User                @relation(fields: [ownerId], references: [id])
  ownerId      String
  photos       Photo[]
  scenes       Scene[]
  favorites    Favorite[]
  nearbyPlaces NearbyPlace[]
  availability AvailabilityRange[]
  reports      Report[]
  events       ListingEvent[]
  features     Feature[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, status, city, sector])
  @@index([price])
  @@index([ownerId])
  @@index([status, createdAt])
}

// Rangos de disponibilidad de una villa (alquiler por día), editables por el
// dueño desde el editor de calendario. BOOKED queda listo para cuando haya
// reservas reales (Fase 2) — hoy solo se crean AVAILABLE/BLOCKED a mano.
model AvailabilityRange {
  id        String             @id @default(uuid())
  listing   Listing            @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String
  startDate DateTime
  endDate   DateTime
  status    AvailabilityStatus @default(AVAILABLE)
  createdAt DateTime           @default(now())

  @@index([listingId, startDate, endDate])
}

// Mínimo para poder contar "guardados" en el perfil del vendedor (Fase 2
// completa — toggle real desde el front — todavía no está conectada; hoy
// "Mi Lista" vive en localStorage, ver useFavorites.ts).
model Favorite {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
  @@index([listingId])
}

model Photo {
  id        String  @id @default(uuid())
  url       String
  thumbUrl  String
  name      String?
  order     Int
  altText   String?
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String

  @@index([listingId, order])
}

model Scene {
  id          String    @id @default(uuid())
  name        String
  panoramaUrl String
  previewUrl  String
  order       Int
  initialYaw  Float     @default(0)
  listing     Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId   String
  hotspots    Hotspot[]

  @@index([listingId, order])
}

model Hotspot {
  id            String      @id @default(uuid())
  type          HotspotType
  yaw           Float
  pitch         Float
  title         String?
  text          String?
  targetSceneId String?
  scene         Scene       @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  sceneId       String

  @@index([sceneId])
}

// Puntos de interés cercanos al inmueble (supermercados, colmados, farmacias,
// escuelas, paradas de transporte público, bancos), detectados vía Overpass
// API a partir de las coordenadas del listado y cacheados aquí — la detección
// no se repite en cada visita a la página.
model NearbyPlace {
  id        String  @id @default(uuid())
  name      String
  category  String
  distanceM Int
  lat       Float
  lng       Float
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String

  @@index([listingId])
}

// ============================================
// Moderación, auditoría, analítica y destacados (Fases 3-7)
// ============================================

model Report {
  id           String       @id @default(uuid())
  listing      Listing      @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId    String
  reporter     User?        @relation("Reporter", fields: [reporterId], references: [id], onDelete: SetNull)
  reporterId   String?
  reason       ReportReason
  details      String?
  status       ReportStatus @default(OPEN)
  createdAt    DateTime     @default(now())
  resolvedAt   DateTime?
  resolvedBy   User?        @relation("Resolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedById String?

  @@index([status, createdAt])
  @@index([listingId])
}

model AuditLog {
  id         String   @id @default(uuid())
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorId    String?
  action     String
  targetType String
  targetId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([createdAt])
}

// Sin userId ni IP (privacidad). value = segundos para TOUR_TIME.
model ListingEvent {
  id        String           @id @default(uuid())
  listing   Listing          @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String
  type      ListingEventType
  value     Int?
  createdAt DateTime         @default(now())

  @@index([listingId, type, createdAt])
  @@index([createdAt]) // purgas por retención
}

model Feature {
  id         String           @id @default(uuid())
  listing    Listing          @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId  String
  placement  FeaturePlacement
  status     FeatureStatus    @default(PENDING)
  startsAt   DateTime
  endsAt     DateTime
  priceCents Int
  currency   String           @default("USD")
  paymentRef String?          @unique // idempotencia del webhook de pago
  createdAt  DateTime         @default(now())

  @@index([placement, status, startsAt, endsAt])
  @@index([listingId])
}
